@model Progress.DTO.WorkoutTemplateDTO

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Create Workout Template";
}

<h2>Create Workout Template</h2>

@if (ViewBag.WarningMessage != null)
{
    <div class="alert alert-warning">
        @ViewBag.WarningMessage
    </div>
}
<div id="form-error" class="text-danger mb-3"></div>

<form id="workout-form" asp-action="Create" method="post">

    <input asp-for="Name"
           id="workout-name"
           class="form-control mb-2"
           placeholder="Workout name (e.g. Full Body)" />
    <span asp-validation-for="Name" class="text-danger"></span>

    <input asp-for="Split"
           id="workout-split"
           class="form-control mb-4"
           placeholder="Split (e.g. Push / Pull / Legs)" />
    <span asp-validation-for="Split" class="text-danger"></span>

    <h4>Exercises</h4>
    <div id="exercises-container"></div>

    <button type="button" id="add-exercise" class="btn btn-primary mt-2 mb-4">
        Add Exercise
    </button>

    <div class="d-flex gap-4 mt-3">
        <button type="submit" id="save-btn" class="btn" disabled
                style="background-color: grey; color: white;">
            Save
        </button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const container = document.getElementById("exercises-container");
            const addBtn = document.getElementById("add-exercise");
            const saveBtn = document.getElementById("save-btn");
            const formError = document.getElementById("form-error");

            const workoutName = document.getElementById("workout-name");
            const workoutSplit = document.getElementById("workout-split");

            let exerciseIndex = 0;

            function createExerciseBlock(i) {
                const div = document.createElement("div");
                div.className = "exercise-block border p-3 mb-3";
                div.dataset.index = i;

                div.innerHTML = `
                    <div class="d-flex gap-2 mb-2 align-items-center">
                        <input class="form-control exercise-name"
                               name="Exercises[${i}].Name"
                               placeholder="Exercise name" />
                        <button type="button" class="btn btn-sm btn-danger remove-exercise">✕</button>
                    </div>
                    <span class="text-danger exercise-name-error"></span>
                    <div class="series-container mt-2"></div>
                    <button type="button" class="btn btn-sm btn-secondary mt-2 add-set">
                        Add Set
                    </button>
                `;

                addSetRow(div.querySelector(".series-container"), i, 10, 10);

                div.addEventListener("input", validateForm);

                return div;
            }

            function addSetRow(container, exIndex, weight, reps) {
                const idx = container.children.length;
                const row = document.createElement("div");
                row.className = "set-row d-flex align-items-center gap-2 mb-2";

                row.innerHTML = `
                    <span class="set-number">${idx + 1}.</span>
                    <input type="hidden"
                           name="Exercises[${exIndex}].Series[${idx}].SetNumber"
                           value="${idx + 1}" />
                    <div class="input-group input-group-sm" style="width:120px">
                        <input type="number" step="0.5" min="0" max="500"
                               class="form-control"
                               name="Exercises[${exIndex}].Series[${idx}].Weight"
                               value="${weight}">
                        <span class="input-group-text">kg</span>
                    </div>
                    <div class="input-group input-group-sm" style="width:120px">
                        <input type="number" step="1" min="1" max="500"
                               class="form-control reps-input"
                               name="Exercises[${exIndex}].Series[${idx}].Reps"
                               value="${reps}"
                               oninput="this.value=this.value.replace(/[^0-9]/g,'')">
                        <span class="input-group-text">reps</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-danger remove-set">✕</button>
                `;

                container.appendChild(row);
            }

            function renumberSets(ex) {
                const sets = ex.querySelectorAll(".set-row");
                sets.forEach((set, idx) => {
                    set.querySelector(".set-number").textContent = (idx + 1) + ".";
                    set.querySelector('[name*="SetNumber"]').value = idx + 1;
                    set.querySelector('[name*="Weight"]').name = `Exercises[${ex.dataset.index}].Series[${idx}].Weight`;
                    set.querySelector('[name*="Reps"]').name = `Exercises[${ex.dataset.index}].Series[${idx}].Reps`;
                });
            }

            function validateExercise(ex) {
                let valid = true;
                const name = ex.querySelector(".exercise-name");
                const nameError = ex.querySelector(".exercise-name-error");

                if (!name.value.trim()) {
                    nameError.textContent = "Exercise name is required.";
                    valid = false;
                } else {
                    nameError.textContent = "";
                }

                const sets = ex.querySelectorAll(".set-row");
                if (sets.length === 0) valid = false;

                sets.forEach(set => {
                    const weightInput = set.querySelector('[name*="Weight"]');
                    const weight = parseFloat(weightInput.value.replace(',', '.'));
                    let weightErr = set.querySelector(".weight-error");

                    if (isNaN(weight) || weight < 0 || weight > 500 || (weight * 2) % 1 !== 0) {
                        valid = false;
                        if (!weightErr) {
                            weightErr = document.createElement("span");
                            weightErr.className = "text-danger weight-error";
                            weightErr.textContent = "Range 0–500 in 0.5 steps.";
                            weightInput.parentElement.appendChild(weightErr);
                        }
                    } else if (weightErr) weightErr.remove();

                    const repsInput = set.querySelector('[name*="Reps"]');
                    const reps = parseInt(repsInput.value);
                    let repsErr = set.querySelector(".reps-error");

                    if (!Number.isInteger(reps) || reps < 1 || reps > 500) {
                        valid = false;
                        if (!repsErr) {
                            repsErr = document.createElement("span");
                            repsErr.className = "text-danger reps-error";
                            repsErr.textContent = "Range 1–500.";
                            repsInput.parentElement.appendChild(repsErr);
                        }
                    } else if (repsErr) repsErr.remove();
                });

                ex.style.borderColor = valid ? "green" : "red";
                return valid;
            }

            function validateForm() {
                let valid =
                    workoutName.value.trim() &&
                    workoutSplit.value.trim() &&
                    container.children.length > 0;

                container.querySelectorAll(".exercise-block").forEach(ex => {
                    if (!validateExercise(ex)) valid = false;
                });

                saveBtn.disabled = !valid;
                saveBtn.style.backgroundColor = valid ? "green" : "grey";
                return valid;
            }

            addBtn.onclick = () => {
                let ok = true;
                container.querySelectorAll(".exercise-block").forEach(ex => {
                    if (!validateExercise(ex)) ok = false;
                });

                if (!ok) {
                    formError.textContent = "Complete all existing exercises before adding a new one.";
                    return;
                }

                formError.textContent = "";
                container.appendChild(createExerciseBlock(exerciseIndex++));
                validateForm();
            };

            // Delegovaný click listener
            container.addEventListener("click", e => {
                const ex = e.target.closest(".exercise-block");

                if (e.target.classList.contains("remove-exercise")) {
                    ex.remove();
                }

                if (e.target.classList.contains("add-set")) {
                    addSetRow(ex.querySelector(".series-container"), ex.dataset.index, 10, 10);
                }

                if (e.target.classList.contains("remove-set")) {
                    const row = e.target.closest(".set-row");
                    row.remove(); // odstraníme úplně z DOM
                    renumberSets(ex);
                }

                validateForm();
            });

            document.addEventListener("input", validateForm);
        });
    </script>
}
