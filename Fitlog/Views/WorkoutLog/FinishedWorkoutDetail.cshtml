@using Progress.DTO
@model WorkoutLogDTO

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Finished workout detail";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="mb-1">@Model.TemplateName</h2>
        <p class="text-muted small">
            Finished at: @(Model.StartedAt?.ToString("dddd, dd MMMM yyyy HH:mm") ?? "-")
        </p>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        @for (int i = 0; i < Model.Exercises.Count; i++)
        {
            <div class="card mb-4 shadow-sm border border-2" style="background-color:#f8f9fa;">

                <div class="card-header bg-transparent border-bottom py-2">
                    <div class="fw-bold text-dark">
                        @Model.Exercises[i].ExerciseName
                    </div>
                    <input type="hidden" asp-for="Exercises[i].Id" />
                </div>

                <div class="card-body p-1">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light small text-muted">
                            <tr>
                                <th style="width: 8%">Set</th>
                                <th style="width: 22%">Weight</th>
                                <th style="width: 22%">Reps</th>
                                <th>Note</th>
                            </tr>
                        </thead>

                        <tbody class="text-secondary">
                            @for (int j = 0; j < Model.Exercises[i].Series.Count; j++)
                            {
                                <tr>
                                    <td class="text-muted">@(j + 1)</td>

                                    <td>
                                        <input type="hidden" asp-for="Exercises[i].Series[j].Id" />
                                        <input asp-for="Exercises[i].Series[j].Weight"
                                               type="number"
                                               step="0.5"
                                               class="form-control form-control-sm" />
                                    </td>

                                    <td>
                                        <input asp-for="Exercises[i].Series[j].Reps"
                                               type="number"
                                               class="form-control form-control-sm" />
                                    </td>

                                    <td>
                                        <input asp-for="Exercises[i].Series[j].Note"
                                               class="form-control form-control-sm" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        }

        <div class="d-flex justify-content-between mt-4">
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>

            <button type="submit" class="btn btn-primary">
                Save changes
            </button>
        </div>
    </form>

    <form asp-action="StartFromFinished" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="finishedWorkoutId" value="@Model.Id" />
        <button type="submit" class="btn btn-success w-100">
            Start workout from this
        </button>
    </form>

</div>
