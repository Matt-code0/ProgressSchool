@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="container mt-5 text-center">
    <h2>@ViewData["Title"]</h2>

    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post" class="mt-3">
            <button type="submit" class="btn btn-primary">
                Click here to Logout
            </button>
        </form>
    }
    else
    {
        <p class="mb-4">You have successfully logged out of the application.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-success">
            Go to Dashboard
        </a>
    }
</div>
